/**
 * @param {number[]} nums
 * @return {number}
 */
var removeDuplicates = function(nums) {
    let last_unique=-101;
    let left=0;
    let right=0;
    for(let x of nums){
        if(nums[right]>last_unique){
            last_unique=nums[right];
            nums[left]=nums[right];
            left++;
        }
        right++;
    }
    return left;
};
